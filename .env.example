# ============================================================================
# .env.example — modelo de variaveis de ambiente do AegisPass
# ----------------------------------------------------------------------------
# Copia este ficheiro para ".env" e ajusta os valores. O ".env" real NUNCA vai
# para o git (esta no .gitignore) porque contem segredos.
#   cp .env.example .env
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=changeme           # ⚠️ trocar por um valor forte em qualquer ambiente real
POSTGRES_DB=aegis
POSTGRES_PORT=5432

# --- Backend (API Go) ---
BACKEND_PORT=8080
# DSN de ligacao a BD. Em docker-compose o host e o nome do servico ("db").
AEGIS_DATABASE_URL=postgres://aegis:changeme@db:5432/aegis?sslmode=disable
# Tempo de graceful shutdown (ex: 10s).
AEGIS_SHUTDOWN_TIMEOUT=10s
# Chave para endpoints admin (remote wipe de terceiros). Vazio = desactivado.
# ⚠️ Valor longo e aleatório; nunca commitar o .env real.
# Dev (docker compose): default dev-admin-change-me
AEGIS_ADMIN_KEY=dev-admin-change-me

# --- Backups cifrados (INFRA-004) ---
# Chave AES-256 em base64 (32 bytes). Gera com: cd backend && go run ./cmd/backup gen-key
# ⚠️ Guardar offline/cofre; sem ela os backups .enc são irrecuperáveis.
AEGIS_BACKUP_KEY=

# --- Mailpit (MAIL-002 dev) ---
# SMTP local: localhost:1025  ·  UI: http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Segredo do webhook Mailpit → backend (query ?secret=). Trocar em produção.
AEGIS_MAIL_WEBHOOK_SECRET=dev-mail-webhook-secret
# Relay SMTP (MAIL-004). Dev: mailpit:1025 dentro do compose.
AEGIS_SMTP_RELAY_HOST=mailpit:1025
# Rate limits por hora (MAIL-005). 0 = omissões seguras no servidor.
AEGIS_MAIL_RATE_INBOUND_HOUR=120
AEGIS_MAIL_RATE_RELAY_HOUR=60
AEGIS_MAIL_RATE_COMPOSE_HOUR=30

# --- Open Banking (FIN-003) — vazio = só mock provider em dev ---
# AEGIS_OB_BASE_URL=https://api.tpp.example/psd2
# AEGIS_OB_CLIENT_CERT=/run/secrets/ob-client.pem
# AEGIS_OB_CLIENT_KEY=/run/secrets/ob-client.key
# AEGIS_OB_CA_CERT=/run/secrets/ob-ca.pem

# --- Google Workspace (GOOGLE-001) — só produção; ver docs/roadmap/10-production/ ---
# AEGIS_GOOGLE_SA_JSON=/run/secrets/google-sa.json
# AEGIS_GOOGLE_DELEGATED_USER=admin@suaempresa.com
# AEGIS_GOOGLE_ENABLED=true

# --- Frontend (dev) ---
# Porta do Vite (playground UI). Proxy /api → BACKEND_PORT.
FRONTEND_PORT=5173
