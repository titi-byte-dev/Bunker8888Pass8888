# ============================================================================
# .env.production.example — modelo para VPS (INFRA-001/003)
# Copiar para .env na VPS: cp .env.production.example .env
# NUNCA commitar o .env real.
# ============================================================================

# --- PostgreSQL (só rede Docker) ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=                    # openssl rand -base64 32
POSTGRES_DB=aegis

# --- Backend ---
BACKEND_PORT=8080
AEGIS_DATABASE_URL=postgres://aegis:CHANGE_ME@db:5432/aegis?sslmode=disable
AEGIS_SHUTDOWN_TIMEOUT=30s
AEGIS_ADMIN_KEY=                      # openssl rand -base64 48

# --- Backups cifrados (INFRA-004) ---
AEGIS_BACKUP_KEY=                     # go run ./cmd/backup gen-key

# --- E-mail produção (MAIL-002/003) ---
AEGIS_MAIL_WEBHOOK_SECRET=            # openssl rand -base64 32
AEGIS_SMTP_RELAY_HOST=host.docker.internal:25
AEGIS_MAIL_RATE_INBOUND_HOUR=120
AEGIS_MAIL_RATE_RELAY_HOUR=60
AEGIS_MAIL_RATE_COMPOSE_HOUR=30

# --- Open Banking (FIN-003) — preencher quando TPP estiver registado ---
# AEGIS_OB_BASE_URL=
# AEGIS_OB_CLIENT_CERT=/run/secrets/ob/client.pem
# AEGIS_OB_CLIENT_KEY=/run/secrets/ob/client.key
# AEGIS_OB_CA_CERT=/run/secrets/ob/ca.pem

# --- Google Workspace (GOOGLE-001) ---
# AEGIS_GOOGLE_SA_JSON=/run/secrets/google-sa.json
# AEGIS_GOOGLE_DELEGATED_USER=admin@suaempresa.com
# AEGIS_GOOGLE_ENABLED=true
