---
import type { SiteCopy } from "../i18n";

interface Props {
  t: SiteCopy;
}

const { t } = Astro.props;
---

<aside class="construction-banner" aria-label={t.construction.badge}>
  <span class="construction-badge">{t.construction.badge}</span>
  <div>
    <p class="construction-title">{t.construction.title}</p>
    <p class="construction-body">{t.construction.body}</p>
  </div>
</aside>

<style>
  .construction-banner {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-8);
    border: 1px dashed color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-bg-inset));
  }

  .construction-badge {
    flex-shrink: 0;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  .construction-title {
    margin: 0 0 var(--space-1);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .construction-body {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
  }
</style>
