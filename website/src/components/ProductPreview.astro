---
import type { SiteCopy } from "../i18n";

interface Props {
  t: SiteCopy;
}

const { t } = Astro.props;
---

<section class="section product-section" id={t.product.id} aria-labelledby="product-title">
  <div class="container product-grid">
    <header class="section-header">
      <p class="section-eyebrow">{t.product.eyebrow}</p>
      <h2 id="product-title" class="section-title">{t.product.title}</h2>
      <p class="section-lead">{t.product.lead}</p>
    </header>

    <div class="mock-app card" aria-hidden="true">
      <div class="mock-chrome">
        <span class="mock-dot"></span>
        <span class="mock-dot"></span>
        <span class="mock-dot"></span>
        <span class="mock-url">app.aegispass.com/vault</span>
      </div>
      <div class="mock-body">
        <aside class="mock-sidebar">
          <span class="mock-nav active">{t.product.mockVault}</span>
          {t.product.mockNavExtra.map((label) => (
            <span class="mock-nav">{label}</span>
          ))}
        </aside>
        <div class="mock-content">
          <div class="mock-toolbar">
            <span class="mock-title">{t.product.mockVault}</span>
            <span class="mock-badge">{t.product.mockStatus}</span>
          </div>
          <ul class="mock-list">
            {t.product.mockItems.map((item, i) => (
              <li class="mock-row" style={`--delay: ${i * 80}ms`}>
                <span class="mock-icon">◆</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .product-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 960px) {
    .product-grid {
      grid-template-columns: 1fr 1.1fr;
      align-items: center;
    }
  }

  .mock-app {
    padding: 0;
    overflow: hidden;
    border-color: color-mix(in srgb, var(--color-accent) 25%, var(--color-border));
    box-shadow: 0 24px 60px color-mix(in srgb, var(--color-bg-base) 55%, transparent);
  }

  .mock-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-inset);
  }

  .mock-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .mock-url {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .mock-body {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    min-height: 14rem;
  }

  .mock-sidebar {
    padding: var(--space-3);
    border-right: 1px solid var(--color-border);
    background: var(--color-bg-inset);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mock-nav {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .mock-nav.active {
    background: var(--color-accent-muted);
    color: var(--color-accent);
    font-weight: 600;
  }

  .mock-content {
    padding: var(--space-4);
  }

  .mock-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .mock-title {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .mock-badge {
    font-size: 0.65rem;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--color-success-fg) 35%, var(--color-border));
    color: var(--color-success-fg);
    white-space: nowrap;
  }

  .mock-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .mock-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    font-size: var(--text-sm);
    animation: row-in var(--duration-normal) var(--ease-out) var(--delay, 0ms) both;
  }

  .mock-icon {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mock-row {
      animation: none;
    }
  }
</style>
