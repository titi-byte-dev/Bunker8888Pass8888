---
import type { SiteCopy } from "../i18n";

interface Props {
  t: SiteCopy;
}

const { t } = Astro.props;
---

<section class="section zk-section" id={t.zk.id} aria-labelledby="zk-title">
  <div class="container">
    <header class="section-header">
      <h2 id="zk-title" class="section-title">{t.zk.title}</h2>
      <p class="section-lead">{t.zk.lead}</p>
    </header>

    <div class="zk-layout">
      <div class="zk-diagram card" role="img" aria-label={t.zk.title}>
        <div class="zk-node zk-node-client">
          <span class="zk-node-label">{t.zk.diagram.client}</span>
          <span class="zk-node-action">{t.zk.diagram.clientAction}</span>
        </div>
        <div class="zk-flow">
          <span class="zk-arrow zk-arrow-out" aria-hidden="true">→</span>
          <span class="zk-payload">{t.zk.diagram.payload}</span>
          <span class="zk-arrow zk-arrow-blocked" aria-hidden="true">✕</span>
        </div>
        <div class="zk-node zk-node-server">
          <span class="zk-node-label">{t.zk.diagram.server}</span>
          <span class="zk-node-action">{t.zk.diagram.serverAction}</span>
        </div>
        <p class="zk-diagram-caption">{t.zk.note}</p>
      </div>

      <ol class="zk-steps card-grid card-grid-zk">
        {
          t.zk.steps.map((step) => (
            <li class="card zk-step">
              <h3 class="zk-step-title">{step.title}</h3>
              <p class="zk-step-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .zk-layout {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 960px) {
    .zk-layout {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  .zk-diagram {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
    padding: var(--space-8) var(--space-6);
  }

  .zk-node {
    width: 100%;
    max-width: 14rem;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 2px solid var(--color-border-strong);
    background: var(--color-bg-surface);
  }

  .zk-node-client {
    border-color: var(--color-accent);
  }

  .zk-node-label {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .zk-node-action {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .zk-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .zk-payload {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-bg-inset);
    font-family: var(--font-mono);
  }

  .zk-arrow-blocked {
    color: var(--color-danger);
    font-weight: 700;
  }

  .zk-diagram-caption {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 20rem;
  }

  .zk-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .zk-step-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .zk-step-body {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }
</style>
