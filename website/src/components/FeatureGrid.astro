---
import type { FeatureItem, SiteCopy } from "../i18n/types";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  title: string;
  items: FeatureItem[];
  t: SiteCopy;
}

const { title, items, t } = Astro.props;
---

<section class="feature-grid-section" aria-labelledby="features-title">
  <h2 id="features-title" class="feature-grid-title">{title}</h2>
  <ul class="feature-grid">
    {
      items.map((item) => (
        <li class="feature-card card">
          <div class="feature-card-head">
            <h3>{item.title}</h3>
            <StatusBadge label={t.statusLabels[item.status]} status={item.status} />
          </div>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .feature-grid-title {
    margin: 0 0 var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .feature-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .feature-card h3 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }

  .feature-card p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }
</style>
