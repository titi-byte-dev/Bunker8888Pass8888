---
import type { SiteCopy } from "../i18n";

interface Props {
  t: SiteCopy;
  appUrl: string;
}

const { t, appUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-tagline">{t.footer.tagline}</p>
      <p class="footer-copy">© {year} AegisPass. {t.footer.rights}</p>
    </div>

    <nav class="footer-nav" aria-label="Institucional">
      <div class="footer-col">
        <span class="footer-heading">{t.footer.about}</span>
        <a href="mailto:hello@aegispass.com">{t.footer.contact}</a>
      </div>
      <div class="footer-col">
        <span class="footer-heading">{t.footer.legal}</span>
        <span class="footer-placeholder">{t.footer.privacy}</span>
        <span class="footer-placeholder">{t.footer.terms}</span>
      </div>
      <div class="footer-col">
        <span class="footer-heading">{t.footer.app}</span>
        <a href={appUrl}>{t.nav.enter}</a>
      </div>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-inset);
    padding-block: var(--space-12);
    margin-top: var(--space-8);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }

  .footer-tagline {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .footer-copy {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-6);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-label);
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--color-link);
    text-decoration: none;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  .footer-placeholder {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
