---
import type { Locale } from "../config";
import {
  pagePath,
  PRODUCT_SLUGS,
  SERVICE_SLUGS,
  productPath,
  servicePath,
  type SiteCopy,
} from "../i18n";

interface Props {
  locale: Locale;
  t: SiteCopy;
  appUrl: string;
}

const { locale, t, appUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-name">{t.site.name}</p>
      <p class="footer-tagline">{t.footer.tagline}</p>
      <p class="footer-copy">© {year}. {t.footer.rights}</p>
    </div>

    <div class="footer-col">
      <span class="footer-heading">{t.footer.columns.products}</span>
      {
        PRODUCT_SLUGS.map((slug) => (
          <a href={productPath(locale, slug)}>{t.nav.productLabels[slug]}</a>
        ))
      }
    </div>

    <div class="footer-col">
      <span class="footer-heading">{t.footer.columns.services}</span>
      {
        SERVICE_SLUGS.map((slug) => (
          <a href={servicePath(locale, slug)}>{t.nav.serviceLabels[slug]}</a>
        ))
      }
    </div>

    <div class="footer-col">
      <span class="footer-heading">{t.footer.columns.company}</span>
      <a href={pagePath(locale, "platform")}>{t.footer.platform}</a>
      <a href={pagePath(locale, "partners")}>{t.footer.partners}</a>
      <a href="mailto:hello@aegispass.com">{t.footer.contact}</a>
    </div>

    <div class="footer-col">
      <span class="footer-heading">{t.footer.columns.legal}</span>
      <span class="footer-muted">{t.footer.privacy}</span>
      <span class="footer-muted">{t.footer.terms}</span>
      <a href={appUrl}>{t.footer.app}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-inset);
    padding-block: var(--space-12);
    margin-top: var(--space-12);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr repeat(4, 1fr);
    }
  }

  .footer-name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .footer-tagline,
  .footer-copy {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-tagline {
    margin-bottom: var(--space-2);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-label);
    margin-bottom: var(--space-1);
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--color-link);
    text-decoration: none;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  .footer-muted {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
