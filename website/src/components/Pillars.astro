---
import type { SiteCopy } from "../i18n";

interface Props {
  t: SiteCopy;
}

const { t } = Astro.props;
---

<section class="section pillars-section" id={t.pillars.id} aria-labelledby="pillars-title">
  <div class="container">
    <header class="section-header">
      <h2 id="pillars-title" class="section-title">{t.pillars.title}</h2>
    </header>

    <div class="card-grid card-grid-3">
      {
        t.pillars.items.map((item) => (
          <article class="card pillar-card">
            <span class="fig-label">FIG {item.fig}</span>
            <h3 class="pillar-title">{item.title}</h3>
            <p class="pillar-body">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillar-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .pillar-body {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }

  .pillar-card {
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .pillar-card:hover {
    border-color: var(--color-border-strong);
  }
</style>
