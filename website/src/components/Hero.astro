---
import type { SiteCopy } from "../i18n";

interface Props {
  t: SiteCopy;
  appUrl: string;
}

const { t, appUrl } = Astro.props;
---

<section class="hero section" aria-labelledby="hero-title">
  <div class="gradient-orb hero-orb" aria-hidden="true"></div>
  <div class="container hero-inner">
    <p class="section-eyebrow reveal">{t.hero.eyebrow}</p>
    <h1 id="hero-title" class="hero-title reveal reveal-delay-1">
      {t.hero.headline}
    </h1>
    <p class="hero-subline reveal reveal-delay-2">{t.hero.subline}</p>
    <div class="hero-ctas reveal reveal-delay-2">
      <a class="btn btn-primary" href={appUrl}>{t.hero.ctaPrimary}</a>
      <a class="btn btn-secondary" href={`#${t.zk.id}`}>{t.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(var(--space-8), 6vw, var(--space-16));
    padding-bottom: clamp(var(--space-12), 10vw, var(--space-16));
  }

  .hero-orb {
    top: -20%;
    right: -10%;
  }

  .hero-inner {
    position: relative;
    max-width: var(--prose-max);
  }

  .hero-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .hero-subline {
    margin: 0 0 var(--space-8);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
    max-width: 38rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
